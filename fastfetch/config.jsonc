{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "general": {},
  "logo": {
    "source": "$HOME/.config/fastfetch/girl.png",
    "type": "kitty-direct",
    "height": 12,
    "width": 28,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 0,
      "bottom": 0
    }
  },
  "modules": [
    "break",
    {
      "type": "host",
      "key": "  dev",
      "format": "{version}",
      "keyColor": "white"
    },
    {
      "type": "cpu",
      "key": "  cpu",
      "format": "{name}",
      "keyColor": "white"
    },
    {
      "type": "gpu",
      "key": "  gpu",
      "format": "{vendor} {name}",
      "keyColor": "white"
    },
    {
      "type": "kernel",
      "key": "  krn",
      "format": "{sysname} on {release}",
      "keyColor": "white"
    },
    {
      "type": "memory",
      "key": "  mem",
      "format": "{used} / {total}",
      "keyColor": "white"
    },
    {
      "type": "uptime",
      "key": "  upt",
      "format": "{hours} hrs {minutes} min",
      "keyColor": "white"
    },
    {
      "type": "os",
      "key": "  opr",
      "format": "{name}",
      "keyColor": "white"
    },
    {
      "type": "wm",
      "key": "  wmn",
      "format": "{pretty-name} {version}",
      "keyColor": "white"
    },
    {
      "type": "terminal",
      "key": "  trm",
      "format": "{pretty-name} {version}",
      "keyColor": "white"
    },
    "break"
  ]
}
