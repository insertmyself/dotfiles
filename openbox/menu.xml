<?xml version="1.0" encoding="UTF-8"?>

<openbox_menu xmlns="http://openbox.org/3.4/menu">

  <menu id="apps-term-menu" label="$ Terminals">
    <item label="$ Kitty">
      <action name="Execute">
        <command>kitty</command>
      </action>
    </item>
  </menu>

  <menu id="apps-net-menu" label="% Internet">
    <item label="% Firefox">
      <action name="Execute">
        <command>firefox</command>
        <startupnotify>
          <enabled>yes</enabled>
        </startupnotify>
      </action>
    </item>
  </menu>

  <menu id="apps-fileman-menu" label="/ File">
    <item label="/ Nautilus">
      <action name="Execute">
        <command>nautilus --no-desktop --browser</command>
        <startupnotify>
          <enabled>yes</enabled>
        </startupnotify>
      </action>
    </item>
  </menu>

  <menu id="apps-graphics-menu" label="@ Graphics">
    <item label="@ Gimp">
      <action name="Execute">
        <command>gimp</command>
        <startupnotify>
          <enabled>yes</enabled>
        </startupnotify>
      </action>
    </item>
    <item label="@ Discord">
      <action name="Execute">
        <command>discord</command>
        <startupnotify>
          <enabled>yes</enabled>
        </startupnotify>
      </action>
    </item>
    <item label="@ Spotify">
      <action name="Execute">
        <command>spotify-launcher</command>
        <startupnotify>
          <enabled>yes</enabled>
        </startupnotify>
      </action>
    </item>
  </menu>

  <menu id="apps-coding-menu" label="> Coding">
    <item label="> Arduino IDE">
      <action name="Execute">
        <command>.local/share/bin/arduino-ide</command>
        <startupnotify>
          <enabled>yes</enabled>
        </startupnotify>
      </action>
    </item>
  </menu>

  <menu id="root-menu" label="Openbox 3">
    <separator label="Applications" />
    <menu id="apps-coding-menu" />
    <menu id="apps-graphics-menu" />
    <menu id="apps-net-menu" />
    <menu id="apps-term-menu" />
    <menu id="apps-fileman-menu" />
    <separator label="System" />
    <item label="! Reload">
      <action name="Reconfigure" />
    </item>
    <separator />
    <item label="= Log Out">
      <action name="Exit">
        <prompt>no</prompt>
      </action>
    </item>
  </menu>

</openbox_menu>
